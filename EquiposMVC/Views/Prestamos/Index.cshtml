@model IEnumerable<EquiposMVC.Models.PrestamoViewModel>
@{
    ViewData["Title"] = "Gestión de Préstamos";
    var userRole = Context.Session.GetString("UserRole");
    var soloVencidos = ViewBag.SoloVencidos is bool b && b;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-journal-bookmark-fill text-primary me-2"></i>
            @(userRole == "Estudiante" ? "Mis Préstamos Solicitados" : "Control General de Préstamos")
        </h2>
        <span class="text-muted">Trazabilidad de equipos prestados, plazos de entrega y estado de devolución</span>
    </div>
    @if (userRole == "Admin" || userRole == "Docente")
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Registrar Préstamo
        </a>
    }
</div>

<!-- Barra de filtros -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body bg-light rounded-3 d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold me-2">Filtrar listado:</span>
            <a asp-action="Index" asp-route-soloVencidos="false" class="btn btn-sm @(!soloVencidos ? "btn-primary" : "btn-outline-primary") me-2">
                Todos los Préstamos
            </a>
            <a asp-action="Index" asp-route-soloVencidos="true" class="btn btn-sm @(soloVencidos ? "btn-danger" : "btn-outline-danger")">
                <i class="bi bi-exclamation-triangle me-1"></i> Solo Préstamos Vencidos
            </a>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Código Equipo</th>
                    <th>Nombre de Equipo</th>
                    @if (userRole != "Estudiante")
                    {
                        <th>Usuario Solicitante</th>
                    }
                    <th>Fecha Préstamo</th>
                    <th>Vencimiento</th>
                    <th>Devolución</th>
                    <th class="text-center">Estado</th>
                    @if (userRole == "Admin" || userRole == "Docente")
                    {
                        <th class="text-end">Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var rowClass = item.EstaVencido ? "table-danger" : "";
                        <tr class="@rowClass">
                            <td class="fw-bold">#@item.Id</td>
                            <td><code>@item.EquipoCodigo</code></td>
                            <td class="fw-semibold">@item.EquipoNombre</td>
                            @if (userRole != "Estudiante")
                            {
                                <td><span class="fw-semibold">@item.UsuarioNombre</span></td>
                            }
                            <td>@item.FechaPrestamo.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="@(item.EstaVencido ? "text-danger fw-bold" : "")">
                                @item.FechaVencimiento.ToString("dd/MM/yyyy")
                            </td>
                            <td>
                                @if (item.EstaDevuelto)
                                {
                                    <span class="text-success"><i class="bi bi-check2-circle me-1"></i>@item.FechaDevolucion?.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <span class="text-muted fst-italic">Pendiente</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.EstaDevuelto)
                                {
                                    <span class="badge bg-success px-3 py-2">Devuelto</span>
                                }
                                else if (item.EstaVencido)
                                {
                                    <span class="badge bg-danger px-3 py-2">Vencido (+@item.DiasAtraso d)</span>
                                }
                                else
                                {
                                    <span class="badge bg-primary px-3 py-2">Vigente</span>
                                }
                            </td>
                            @if (userRole == "Admin" || userRole == "Docente")
                            {
                                <td class="text-end">
                                    @if (!item.EstaDevuelto)
                                    {
                                        <a asp-action="Devolucion" asp-route-id="@item.Id" class="btn btn-outline-success btn-sm">
                                            <i class="bi bi-arrow-return-left me-1"></i> Registrar Devolución
                                        </a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No se encontraron préstamos registrados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
