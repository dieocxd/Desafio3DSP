@model EquiposMVC.Models.PrestamoDevolucionViewModel
@{
    ViewData["Title"] = "Registrar Devolución";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-success text-white py-3">
                <h4 class="mb-0 fw-bold"><i class="bi bi-arrow-return-left me-2"></i>Registrar Devolución de Equipo</h4>
            </div>
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="bg-light p-3 rounded mb-4">
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Préstamo #:</div>
                        <div class="col-sm-8 fw-bold">@Model.Id</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Equipo:</div>
                        <div class="col-sm-8 fw-bold text-primary">[@Model.EquipoCodigo] @Model.EquipoNombre</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Prestatario:</div>
                        <div class="col-sm-8 fw-bold">@Model.UsuarioNombre</div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-sm-4 text-muted">Fecha Préstamo:</div>
                        <div class="col-sm-8">@Model.FechaPrestamo.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                    <div class="row">
                        <div class="col-sm-4 text-muted">Vencimiento:</div>
                        <div class="col-sm-8">@Model.FechaVencimiento.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <form asp-action="Devolucion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-4">
                        <label asp-for="Observaciones" class="form-label fw-semibold"></label>
                        <textarea asp-for="Observaciones" class="form-control" rows="3" placeholder="Estado en que se recibe el equipo (ej. 'Entregado en óptimas condiciones con cargador')..."></textarea>
                        <span asp-validation-for="Observaciones" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Cancelar
                        </a>
                        <button type="submit" class="btn btn-success">
                            <i class="bi bi-check-lg me-1"></i> Confirmar Devolución
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
