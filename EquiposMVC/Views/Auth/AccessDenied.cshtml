@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="text-danger fw-bold">403 - Acceso Denegado</h2>
            <p class="lead text-secondary my-3">
                No posee los privilegios necesarios para realizar esta acción o visualizar este recurso.
            </p>
            <p class="text-muted small">
                Su rol actual es <strong>@Context.Session.GetString("UserRole")</strong>. Esta operación está restringida por la política de seguridad del laboratorio.
            </p>
            <div class="mt-4">
                <a asp-controller="Equipos" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house-door me-1"></i> Volver a Equipos
                </a>
            </div>
        </div>
    </div>
</div>
