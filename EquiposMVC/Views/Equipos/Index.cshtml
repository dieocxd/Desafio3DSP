@model EquiposMVC.Models.EquipoIndexViewModel
@{
    ViewData["Title"] = "Inventario de Equipos";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark">
            <i class="bi bi-laptop text-primary me-2"></i>
            @(userRole == "Estudiante" ? "Equipos Disponibles para Préstamo" : "Catálogo General de Equipos")
        </h2>
        <span class="text-muted">Gestión, consulta y estado del inventario informático</span>
    </div>
    @if (userRole == "Admin")
    {
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg me-1"></i> Registrar Equipo
        </a>
    }
</div>

<!-- Filtros combinables -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body bg-light rounded-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-semibold small">Búsqueda por Texto:</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="texto" class="form-control" placeholder="Buscar por código, nombre o descripción..." value="@Model.Texto" />
                </div>
            </div>

            <div class="col-md-3">
                <label class="form-label fw-semibold small">Filtrar por Categoría:</label>
                <select name="categoriaId" class="form-select">
                    <option value="">-- Todas las Categorías --</option>
                    @foreach (var cat in Model.Categorias)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoriaId == cat.Id ? "selected" : null)">@cat.Nombre</option>
                    }
                </select>
            </div>

            @if (userRole != "Estudiante")
            {
                <div class="col-md-3">
                    <label class="form-label fw-semibold small">Filtrar por Estado:</label>
                    <select name="estado" class="form-select">
                        <option value="">-- Todos los Estados --</option>
                        <option value="Disponible" selected="@(Model.Estado == "Disponible" ? "selected" : null)">Disponible</option>
                        <option value="Prestado" selected="@(Model.Estado == "Prestado" ? "selected" : null)">Prestado</option>
                        <option value="Mantenimiento" selected="@(Model.Estado == "Mantenimiento" ? "selected" : null)">Mantenimiento</option>
                    </select>
                </div>
            }

            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                    <i class="bi bi-arrow-clockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Equipos -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Código</th>
                    <th>Nombre del Equipo</th>
                    <th>Categoría</th>
                    <th>Descripción</th>
                    <th class="text-center">Estado</th>
                    <th class="text-end" style="min-width: 180px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items != null && Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-light text-dark border fw-bold fs-6">@item.CodigoInventario</span></td>
                            <td class="fw-semibold">@item.Nombre</td>
                            <td><span class="badge bg-info text-dark">@item.CategoriaNombre</span></td>
                            <td><small class="text-muted">@item.Descripcion</small></td>
                            <td class="text-center">
                                @if (item.Estado == "Disponible")
                                {
                                    <span class="badge bg-success px-3 py-2">Disponible</span>
                                }
                                else if (item.Estado == "Prestado")
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">Prestado</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">Mantenimiento</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm" title="Ver Detalle">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @if (userRole == "Admin" || userRole == "Docente")
                                {
                                    @if (item.Estado == "Disponible")
                                    {
                                        <a asp-controller="Prestamos" asp-action="Create" asp-route-equipoId="@item.Id" class="btn btn-outline-success btn-sm ms-1" title="Prestar este equipo">
                                            <i class="bi bi-hand-index-thumb"></i> Prestar
                                        </a>
                                    }
                                }

                                @if (userRole == "Admin")
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-warning btn-sm ms-1" title="Editar Equipo">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-outline-danger btn-sm ms-1" title="Eliminar Equipo">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            No se encontraron equipos que coincidan con los criterios de búsqueda.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación de 10 registros por página -->
    @if (Model.TotalPaginas > 1)
    {
        <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
            <span class="small text-muted">
                Mostrando página <strong>@Model.PaginaActual</strong> de <strong>@Model.TotalPaginas</strong> (Total: @Model.TotalRegistros registros)
            </span>
            <nav aria-label="Navegación de páginas">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.TienePaginaAnterior ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" 
                           asp-route-pagina="@(Model.PaginaActual - 1)"
                           asp-route-texto="@Model.Texto"
                           asp-route-categoriaId="@Model.CategoriaId"
                           asp-route-estado="@Model.Estado">
                            <i class="bi bi-chevron-left"></i> Anterior
                        </a>
                    </li>

                    @for (int i = 1; i <= Model.TotalPaginas; i++)
                    {
                        <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                            <a class="page-link" asp-action="Index"
                               asp-route-pagina="@i"
                               asp-route-texto="@Model.Texto"
                               asp-route-categoriaId="@Model.CategoriaId"
                               asp-route-estado="@Model.Estado">@i</a>
                        </li>
                    }

                    <li class="page-item @(!Model.TienePaginaSiguiente ? "disabled" : "")">
                        <a class="page-link" asp-action="Index"
                           asp-route-pagina="@(Model.PaginaActual + 1)"
                           asp-route-texto="@Model.Texto"
                           asp-route-categoriaId="@Model.CategoriaId"
                           asp-route-estado="@Model.Estado">
                            Siguiente <i class="bi bi-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
