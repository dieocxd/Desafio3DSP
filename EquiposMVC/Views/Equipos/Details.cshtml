@model EquiposMVC.Models.EquipoViewModel
@{
    ViewData["Title"] = "Detalle del Equipo";
    var userRole = Context.Session.GetString("UserRole");
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-info-circle me-2"></i>Ficha Técnica del Equipo</h4>
                <span class="badge bg-light text-dark border">#ID: @Model.Id</span>
            </div>
            <div class="card-body p-4">
                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Código de Inventario:</div>
                    <div class="col-sm-8 fw-bold"><code>@Model.CodigoInventario</code></div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Nombre del Equipo:</div>
                    <div class="col-sm-8 fw-bold fs-5">@Model.Nombre</div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Categoría:</div>
                    <div class="col-sm-8"><span class="badge bg-info text-dark">@Model.CategoriaNombre</span></div>
                </div>

                <div class="row mb-3">
                    <div class="col-sm-4 text-muted">Estado Actual:</div>
                    <div class="col-sm-8">
                        @if (Model.Estado == "Disponible")
                        {
                            <span class="badge bg-success px-3 py-2">Disponible</span>
                        }
                        else if (Model.Estado == "Prestado")
                        {
                            <span class="badge bg-warning text-dark px-3 py-2">Prestado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary px-3 py-2">Mantenimiento</span>
                        }
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-sm-4 text-muted">Descripción / Notas:</div>
                    <div class="col-sm-8">
                        <p class="text-secondary mb-0">@(string.IsNullOrWhiteSpace(Model.Descripcion) ? "Sin descripción detallada." : Model.Descripcion)</p>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i> Regresar al Listado
                    </a>

                    <div>
                        @if ((userRole == "Admin" || userRole == "Docente") && Model.Estado == "Disponible")
                        {
                            <a asp-controller="Prestamos" asp-action="Create" asp-route-equipoId="@Model.Id" class="btn btn-success me-2">
                                <i class="bi bi-hand-index-thumb me-1"></i> Prestar Equipo
                            </a>
                        }

                        @if (userRole == "Admin")
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                                <i class="bi bi-pencil-square me-1"></i> Editar
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
