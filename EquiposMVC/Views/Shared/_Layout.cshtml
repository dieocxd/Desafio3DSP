<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Préstamo de Equipos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>
<body class="bg-light d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Equipos" asp-action="Index">
                    <i class="bi bi-laptop me-2"></i>LabPrestamos UDB
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("JwtToken")))
                        {
                            var rol = Context.Session.GetString("UserRole");

                            // Menú dinámico según rol
                            if (rol == "Estudiante")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Equipos" asp-action="Index">
                                        <i class="bi bi-grid me-1"></i> Equipos Disponibles
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Prestamos" asp-action="Index">
                                        <i class="bi bi-clock-history me-1"></i> Mis Préstamos
                                    </a>
                                </li>
                            }
                            else if (rol == "Docente")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Equipos" asp-action="Index">
                                        <i class="bi bi-grid me-1"></i> Catálogo de Equipos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Prestamos" asp-action="Index">
                                        <i class="bi bi-journal-text me-1"></i> Todos los Préstamos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Prestamos" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i> Nuevo Préstamo
                                    </a>
                                </li>
                            }
                            else if (rol == "Admin")
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Equipos" asp-action="Index">
                                        <i class="bi bi-pc-display me-1"></i> Equipos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Categorias" asp-action="Index">
                                        <i class="bi bi-tags me-1"></i> Categorías
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Prestamos" asp-action="Index">
                                        <i class="bi bi-journal-check me-1"></i> Préstamos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Prestamos" asp-action="Create">
                                        <i class="bi bi-plus-circle me-1"></i> Prestar Equipo
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Auth" asp-action="Register">
                                        <i class="bi bi-person-plus me-1"></i> Registrar Usuario
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-warning fw-semibold" href="http://localhost:5200" target="_blank">
                                        <i class="bi bi-file-earmark-bar-graph me-1"></i> Reportes <i class="bi bi-box-arrow-up-right small"></i>
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto">
                        @if (!string.IsNullOrEmpty(Context.Session.GetString("JwtToken")))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-white fw-semibold" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i> @Context.Session.GetString("Username") 
                                    <span class="badge bg-light text-dark ms-1">@Context.Session.GetString("UserRole")</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><h6 class="dropdown-header">Usuario Conectado</h6></li>
                                    <li><span class="dropdown-item-text small text-muted">@Context.Session.GetString("Email")</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link btn btn-outline-light px-3 text-white" asp-controller="Auth" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container my-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @TempData["InfoMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="bg-white border-top py-3 text-center text-muted small mt-auto">
        <div class="container">
            <span>&copy; 2026 - Universidad Don Bosco · Laboratorio de Cómputo · Control de Préstamos</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
