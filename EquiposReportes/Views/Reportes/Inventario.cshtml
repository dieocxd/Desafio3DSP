@model EquiposReportes.ViewModels.InventarioCategoriaReportViewModel
@{
    ViewData["Title"] = "Inventario por Categoría";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-dark"><i class="bi bi-pie-chart-fill text-primary me-2"></i>Inventario por Categoría</h2>
        <span class="text-muted">Cantidad de equipos agrupados por categoría y discriminados por estado actual</span>
    </div>
    <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> Imprimir Reporte
    </button>
</div>

<!-- Filtros -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body bg-light rounded-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Filtrar por Categoría:</label>
                <select name="categoriaId" class="form-select">
                    <option value="">-- Todas las categorías --</option>
                    @foreach (var cat in Model.Categorias)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoriaId == cat.Id ? "selected" : null)">@cat.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Aplicar Filtro
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Inventario" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-clockwise me-1"></i> Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tarjetas de Resumen -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card text-white bg-primary shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-uppercase mb-1 small">Total Equipos</h6>
                <div class="display-6 fw-bold">@Model.TotalEquiposGeneral</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-uppercase mb-1 small">Disponibles</h6>
                <div class="display-6 fw-bold">@Model.TotalDisponiblesGeneral</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-dark bg-warning shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-uppercase mb-1 small">Prestados</h6>
                <div class="display-6 fw-bold">@Model.TotalPrestadosGeneral</div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-secondary shadow-sm h-100">
            <div class="card-body">
                <h6 class="card-title text-uppercase mb-1 small">En Mantenimiento</h6>
                <div class="display-6 fw-bold">@Model.TotalMantenimientoGeneral</div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3">
        <h5 class="mb-0 fw-semibold text-secondary">Desglose por Categoría</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Categoría</th>
                    <th class="text-center">Total Equipos</th>
                    <th class="text-center">Disponibles</th>
                    <th class="text-center">Prestados</th>
                    <th class="text-center">Mantenimiento</th>
                    <th class="text-end">Disponibilidad %</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        var pct = item.TotalEquipos > 0 ? (item.CantidadDisponibles * 100.0 / item.TotalEquipos) : 0;
                        <tr>
                            <td class="fw-bold">@item.CategoriaNombre</td>
                            <td class="text-center"><span class="badge bg-primary px-3 py-2 fs-6">@item.TotalEquipos</span></td>
                            <td class="text-center"><span class="badge bg-success px-3 py-2 fs-6">@item.CantidadDisponibles</span></td>
                            <td class="text-center"><span class="badge bg-warning text-dark px-3 py-2 fs-6">@item.CantidadPrestados</span></td>
                            <td class="text-center"><span class="badge bg-secondary px-3 py-2 fs-6">@item.CantidadMantenimiento</span></td>
                            <td class="text-end fw-semibold">
                                <div class="progress" style="height: 18px;">
                                    <div class="progress-bar bg-success" role="progressbar" style="width: @pct.ToString("0")%;">
                                        @pct.ToString("0")%
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            No se encontraron registros para los filtros seleccionados.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
