@model EquiposReportes.ViewModels.PrestamosVencidosReportViewModel
@{
    ViewData["Title"] = "Préstamos Vencidos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-0 text-danger"><i class="bi bi-exclamation-octagon-fill me-2"></i>Reporte de Préstamos Vencidos</h2>
        <span class="text-muted">Equipos cuya fecha de vencimiento ya expiró y aún no han sido devueltos al laboratorio</span>
    </div>
    <button class="btn btn-outline-secondary btn-sm" onclick="window.print()">
        <i class="bi bi-printer me-1"></i> Imprimir Reporte
    </button>
</div>

<!-- Filtros -->
<div class="card shadow-sm mb-4 border-0">
    <div class="card-body bg-light rounded-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label fw-semibold">Filtrar por Categoría del Equipo:</label>
                <select name="categoriaId" class="form-select">
                    <option value="">-- Todas las categorías --</option>
                    @foreach (var cat in Model.Categorias)
                    {
                        <option value="@cat.Id" selected="@(Model.CategoriaId == cat.Id ? "selected" : null)">@cat.Nombre</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-danger w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar Vencidos
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Vencidos" class="btn btn-outline-secondary w-100">
                    <i class="bi bi-arrow-clockwise me-1"></i> Limpiar
                </a>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-warning d-flex align-items-center justify-content-between shadow-sm">
    <div>
        <i class="bi bi-bell-fill me-2 fs-5 text-danger"></i>
        <span>Total de préstamos actualmente vencidos y pendientes de entrega:</span>
    </div>
    <span class="badge bg-danger fs-5 px-3 py-2">@Model.TotalVencidos Préstamos</span>
</div>

<!-- Tabla de Préstamos Vencidos -->
<div class="card shadow-sm border-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-danger text-danger">
                <tr>
                    <th># Préstamo</th>
                    <th>Código Equipo</th>
                    <th>Nombre de Equipo</th>
                    <th>Categoría</th>
                    <th>Usuario Responsable</th>
                    <th>Fecha Préstamo</th>
                    <th>Fecha Vencimiento</th>
                    <th class="text-center">Días de Atraso</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Any())
                {
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-bold">#@item.PrestamoId</td>
                            <td><code>@item.EquipoCodigo</code></td>
                            <td class="fw-semibold">@item.EquipoNombre</td>
                            <td><span class="badge bg-secondary">@item.CategoriaNombre</span></td>
                            <td>
                                <div><strong>@item.UsuarioNombre</strong></div>
                                <small class="text-muted">@item.UsuarioEmail</small>
                            </td>
                            <td>@item.FechaPrestamo.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="text-danger fw-bold">@item.FechaVencimiento.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <span class="badge bg-danger px-3 py-2 fs-6">
                                    <i class="bi bi-clock-history me-1"></i> @item.DiasAtraso día(s)
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-success">
                            <i class="bi bi-check-circle-fill fs-2 d-block mb-2"></i>
                            <strong>¡Excelente! No hay préstamos vencidos pendientes en este momento.</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
