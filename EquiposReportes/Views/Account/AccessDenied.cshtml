@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger p-5">
            <div class="mb-3 text-danger">
                <i class="bi bi-shield-x display-1"></i>
            </div>
            <h2 class="text-danger fw-bold">403 - Acceso Denegado</h2>
            <p class="lead text-secondary my-3">
                No tiene los privilegios necesarios para acceder al módulo de reportes.
            </p>
            <p class="text-muted small">
                Este módulo requiere estrictamente el rol <strong>Admin</strong>. Si ha iniciado sesión como Docente o Estudiante, por favor cierre sesión e ingrese con una cuenta de Administrador.
            </p>
            <div class="mt-4">
                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger me-2">
                        <i class="bi bi-box-arrow-left me-1"></i> Cambiar de Cuenta
                    </button>
                </form>
                <a href="http://localhost:5100" class="btn btn-primary">
                    <i class="bi bi-arrow-return-left me-1"></i> Ir al Portal Operativo (EquiposMVC)
                </a>
            </div>
        </div>
    </div>
</div>
